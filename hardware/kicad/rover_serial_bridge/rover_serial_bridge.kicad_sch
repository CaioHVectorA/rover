	)
	(text "ESP GPIO43 (TX) -> R1 1k -> base Q1 (BC337). Emissor no GND.\nColetor -> Nano D2 (RX) e pull-up R2 10k no +5V do Nano.\nO transistor sobe o nivel para 5V, mas INVERTE o sinal: no Nano use SoftwareSerial com logica invertida\n(SoftwareSerial(rx, tx, true)). GND do ESP e do Nano ligados juntos."
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c9393e42-efd0-477d-b6e6-a36d7cc58547")
	)
	(text "BC337 TO-92 (face plana para voce): 1 = Coletor | 2 = Base | 3 = Emissor"
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "76bbf38f-e436-4444-995a-6256e65322d0")
