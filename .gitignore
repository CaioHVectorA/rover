# Office / Excel temporary files
~$*.xlsx
~$*.xls
~$*.docx
.~lock.*#

# Python cache
__pycache__/
*.py[cod]
*$py.class

# PlatformIO, Arduino & C++ builds
.pio/
.vscode/
compile_commands.json

# Node.js
node_modules/

# Arquivos de sistema
.DS_Store
Thumbs.db

# Diagnósticos e logs de artefatos
*.inspect.ndjson

# Estado local e travas do KiCad
*.kicad_prl
*.lck
_autosave-*

# Root scratch directory
/scratch/

# Credenciais de Wi-Fi dos firmwares (modelo: credenciais.exemplo.h)
src/firmware/comum/credenciais.h

# Lixo de build dentro de sketches legados
src/firmware/legado/**/.pio/
